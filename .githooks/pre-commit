#!/usr/bin/env bash
# Read-only index check. A commit must not regenerate data, rebuild the PDF, or
# silently stage files: these actions would invalidate the reviewed run identity
# and interfere with splitting a scientific revision into coherent commits.
#
# Rebuild explicitly with scripts/rebuild_thesis.py; review subsequent manuscript
# edits with scripts/review_thesis.py. This hook checks whitespace only. It does
# not certify scientific correctness, output freshness, or source/PDF agreement.
# Enable with: git config core.hooksPath .githooks
set -euo pipefail

# Preserve Windows line endings in historical author notes while checking actual
# trailing blanks, terminal blank lines and spaces preceding indentation tabs.
git -c core.whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol diff --cached --check
