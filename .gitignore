# Ambienti / packaging
.venv/
venv/
env/
*.egg-info/
build/
dist/

# Cache Python / tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Documentazione generata
site/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Dati grezzi: NON vanno mai nel repo (stanno sull'SSD esterno).
# Struttura: data/<disciplina>/ (paragliders/, hang_gliders/). Versioniamo SOLO i piccoli
# data/<disciplina>/seasons_index.csv; i catalog.csv (grandi, derivati) restano locali.
/data/*/catalog.csv
/data/*/track_scan.parquet
/data/*/igc/
/data/*/raw_xml/
/data/*/logs/
*.igc
# ...eccetto la piccola fixture di test del parser IGC, che va versionata.
!/tests/fixtures/*.igc

# Tesi (documento PUBBLICO): teniamo i .tex, thesis/generated/*.tex e thesis/main.pdf;
# ignoriamo solo gli ausiliari di LaTeX.
thesis/*.aux
thesis/*.bbl
thesis/*.bcf
thesis/*.blg
thesis/*.fdb_latexmk
thesis/*.fls
thesis/*.log
thesis/*.out
thesis/*.run.xml
thesis/*.synctex.gz
thesis/*.toc
thesis/*.lof
thesis/*.lot
thesis/*.ptc

# Archivio locale dei PDF/snapshot delle opere citate (una copia per chiave BibTeX):
# NON va mai versionato ne' pushato. Inventario e provenienza di ogni file:
# docs/guide/bibliography.md
thesis/references/

# Generated diagnostic PDFs remain local unless required by the manuscript.
# Required figures are versioned below so the committed manuscript has its inputs.
thesis/generated/*.pdf

# Figures required by the revised manuscript (also reproducible from their manifests).
!thesis/generated/msd.pdf
!thesis/generated/kinematic_isotropy_terrain.pdf
!thesis/generated/ch3_*.pdf
!thesis/generated/quantile_scaling_schematic.pdf
!thesis/generated/closed_loop_schematic.pdf
!thesis/generated/moment_spectrum_schematic.pdf
!thesis/generated/cleaning_defects_schematic.pdf
!thesis/generated/vertical_median_explainer.pdf
!thesis/generated/cleaning_real_examples.pdf
!thesis/generated/segmentation_current_example_*.pdf
!thesis/generated/segmentation_decoding_transitions.pdf
!thesis/generated/segmentation_decoder_ablation.pdf
!thesis/generated/segmentation_coverage.pdf

# Copie in stile Finder ("nome 2.py"): compaiono da sole su questo filesystem e, se sono
# test, vengono raccolte ed eseguite due volte -- 101 test fantasma in un'occasione.
# Lo spazio prima della cifra distingue una copia da un nome che finisce legittimamente
# con un numero (es. 01_fondamenta.md, C2-dataset.tex).
* [0-9].*
* [0-9][0-9].*

# LaTeX run from the repository root instead of thesis/. It happens when a
# shell keeps its working directory across commands, and the artefacts land beside the
# source tree where nothing else ignores them.
/main.aux
/main.fdb_latexmk
/main.fls
/main.log
/main.out
/main.pdf
/main.toc
/main.synctex.gz

# Exact configured Savitzky-Golay response used by the revised methods chapter.
!thesis/generated/savgol_response.pdf

